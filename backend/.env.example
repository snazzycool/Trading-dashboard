# .env.example — Copy to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────
# Get a free key at https://twelvedata.com (800 credits/day on free tier)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Supabase (required for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Capital.com (optional - for auto trading) ──────────────────────────────
CAPITAL_API_KEY=your_capital_api_key
CAPITAL_PASSWORD=your_capital_password
CAPITAL_IDENTIFIER=your_capital_identifier
CAPITAL_ENV=demo  # or "live"

# ── Optional ──────────────────────────────────────────────────────────────
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
